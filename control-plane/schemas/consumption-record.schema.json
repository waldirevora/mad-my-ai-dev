{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mad.local/schemas/consumption-record-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "approval_id", "nonce", "operation",
    "started_at", "completed_at", "external_request_id", "pr", "outcome",
    "pre_action_sha256", "post_action_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "mad-consumption-record"},
    "approval_id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation": {"enum": ["create-pr", "merge"]},
    "started_at": {"type": "integer", "minimum": 0},
    "completed_at": {"type": ["integer", "null"], "minimum": 0},
    "external_request_id": {"type": ["string", "null"], "maxLength": 1000},
    "pr": {"type": ["integer", "null"], "minimum": 1},
    "outcome": {"enum": ["consuming", "success", "failure", "indeterminate"]},
    "pre_action_sha256": {"$ref": "#/$defs/sha256"},
    "post_action_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
