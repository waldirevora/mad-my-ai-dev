{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorapulse.com.br/mad/schemas/orka-review-attestation-v1",
  "title": "MAD Orka review attestation v1 (D1 verifier only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "attestation_id",
    "issuer",
    "issued_at",
    "expires_at",
    "nonce",
    "repository",
    "pr",
    "source",
    "target",
    "challenge_sha256",
    "policy_sha256",
    "review_generation",
    "gate",
    "reviewer",
    "review_run_id",
    "verdict",
    "result_sha256",
    "orka",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "mad.orka.review-attestation.v1"
    },
    "kind": {
      "const": "mad-orka-review-attestation"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "key_id"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "database_id",
        "name_with_owner"
      ],
      "properties": {
        "host": {
          "const": "github.com"
        },
        "database_id": {
          "type": "integer",
          "minimum": 1
        },
        "name_with_owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_id",
        "number"
      ],
      "properties": {
        "database_id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "branch",
        "sha"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "branch",
        "sha"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_generation": {
      "type": "integer",
      "minimum": 1
    },
    "gate": {
      "enum": [
        "code-review",
        "security-review"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provider",
        "model",
        "execution_identity"
      ],
      "properties": {
        "role": {
          "enum": [
            "code-reviewer",
            "security-reviewer"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "execution_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "review_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "orka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "version",
        "runtime_sha256",
        "ledger_sha256",
        "permit_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "permit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
